{
  "name": "ncsuguessr",
  "version": "1.0.0",
  "scripts": {
    "typecheck": "npx tsc --build --noEmit",
    "build:mobile:web": "npm run build-web --workspace=mobile",
    "deploy:staging": "npm run deploy:staging --workspace=api",
    "deploy:prod": "npm run deploy:prod --workspace=api",
    "dev:api": "npm run build:mobile:web && npm run dev:staging --workspace=api",
    "dev:mobile": "npm run start --workspace=mobile",
    "check": "npx prettier . --check",
    "format": "npx prettier . --write",
    "build:admin": "npm run build --workspace admin"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "NC State geolocation guessing game",
  "workspaces": [
    "admin",
    "api",
    "types",
    "mobile"
  ],
  "private": true,
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-native-web": "^0.21.1",
    "zod": "^4.1.8"
  }
}
